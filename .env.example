# Copia este archivo a .env y reemplaza los valores de ejemplo.
#   cp .env.example .env
# Genera cada secreto con: openssl rand -hex 32
# No reutilices el mismo valor entre variables.

# n8n version - get the version number of the latest stable release from https://github.com/n8n-io/n8n/releases
N8N_VERSION=2.46.6

# Sandbox service version - the API, runner, and sandbox images share one release.
# Get the number of the latest stable "service" release (not a staging prerelease) from https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=1.14.0

# n8n task runner authentication.
N8N_RUNNERS_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# Sandbox service secrets.
SANDBOX_API_KEYS=replace-with-openssl-rand-hex-32
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-openssl-rand-hex-32
SANDBOX_RUNNER_API_KEYS=replace-with-openssl-rand-hex-32

# Must match one of the values in SANDBOX_API_KEYS above.
# This is how n8n authenticates to the sandbox.
N8N_SANDBOX_SERVICE_API_KEY=replace-with-same-value-as-a-key-in-SANDBOX_API_KEYS

# Web search: secret for the bundled SearXNG instance.
SEARXNG_SECRET=replace-with-openssl-rand-hex-32
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
